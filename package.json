{
  "name": "adaptive-brightness-electron",
  "version": "2.0.0",
  "description": "An Electron application for adaptive monitor brightness control.",
  "main": "main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.electron.adaptivebrightness",
    "productName": "Adaptive Brightness Control",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "*.tsx",
      "*.ts",
      "components/**/*",
      "hooks/**/*",
      "services/**/*",
      "translations/**/*",
      "server/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}